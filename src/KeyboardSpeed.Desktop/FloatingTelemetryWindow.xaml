<Window x:Class="KeyboardSpeed.Desktop.FloatingTelemetryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FloatingTelemetryWindow"
        Width="392"
        Height="452"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Background="#F9FCFF"
            BorderBrush="#D3E1EF"
            BorderThickness="1"
            CornerRadius="24"
            Padding="18"
            MouseLeftButtonDown="OnShellMouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontSize="11"
                               Foreground="#4C84B3"
                               Text="FLOATING TELEMETRY" />
                    <TextBlock x:Name="DeviceNameTextBlock"
                               Margin="0,8,0,0"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"
                               Text="未连接设备" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right">
                    <Border Background="#EAF3FF"
                            BorderBrush="#C7D8EA"
                            BorderThickness="1"
                            CornerRadius="999"
                            Padding="10,6"
                            HorizontalAlignment="Right">
                        <TextBlock x:Name="ConnectionStatusTextBlock"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#0F766E"
                                   Text="--" />
                    </Border>

                    <Border Margin="0,8,0,0"
                            Background="#EEF5FF"
                            BorderBrush="#CADAEA"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="12,8">
                        <StackPanel>
                            <TextBlock FontSize="10"
                                       Foreground="#6B84A0"
                                       Text="字符/分钟" />
                            <TextBlock x:Name="CharactersPerMinuteTextBlock"
                                       Margin="0,4,0,0"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"
                                       Text="0.0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2"
                    Background="#FFFFFF"
                    BorderBrush="#D7E2EF"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#355D88"
                                   Text="实时波形" />

                        <Border Grid.Column="1"
                                Background="#EEF5FF"
                                BorderBrush="#CADAEA"
                                BorderThickness="1"
                                CornerRadius="999"
                                Padding="10,5">
                            <TextBlock x:Name="CurrentWaveformTextBlock"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#4E78A0"
                                       Text="未触发" />
                        </Border>
                    </Grid>

                    <Canvas x:Name="WaveformCanvas"
                            Grid.Row="2"
                            Height="96"
                            Background="#F7FAFD" />
                </Grid>
            </Border>

            <Border Grid.Row="4"
                    Background="#FFFFFF"
                    BorderBrush="#D7E2EF"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#355D88"
                               Text="实时强度" />

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Background="#FFFFFF"
                                BorderBrush="#D7E2EF"
                                BorderThickness="1"
                                CornerRadius="16"
                                MinHeight="104"
                                Padding="12">
                            <StackPanel>
                                <TextBlock FontSize="11"
                                           Foreground="#86CFCB"
                                           Text="A 强度" />
                                <TextBlock x:Name="ChannelATextBlock"
                                           Margin="0,6,0,0"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"
                                           Text="0/180" />
                                <Border Height="12"
                                        Margin="0,10,0,0"
                                        Background="#EAF1F8"
                                        BorderBrush="#D7E2EF"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <Border x:Name="ChannelABar"
                                            HorizontalAlignment="Left"
                                            Width="0"
                                            Background="#4FD1C5"
                                            CornerRadius="6" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Background="#FFFFFF"
                                BorderBrush="#D7E2EF"
                                BorderThickness="1"
                                CornerRadius="16"
                                MinHeight="104"
                                Padding="12">
                            <StackPanel>
                                <TextBlock FontSize="11"
                                           Foreground="#F6C27A"
                                           Text="B 强度" />
                                <TextBlock x:Name="ChannelBTextBlock"
                                           Margin="0,6,0,0"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"
                                           Text="0/180" />
                                <Border Height="12"
                                        Margin="0,10,0,0"
                                        Background="#EAF1F8"
                                        BorderBrush="#D7E2EF"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <Border x:Name="ChannelBBar"
                                            HorizontalAlignment="Left"
                                            Width="0"
                                            Background="#F59E0B"
                                            CornerRadius="6" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
