<Window x:Class="KeyboardSpeed.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Keyboard Speed YOKONEX"
        Icon="Assets/yokonex-logo.png"
        Height="920"
        Width="1560"
        MinHeight="820"
        MinWidth="1360"
        WindowStartupLocation="CenterScreen"
        Background="#F5F8FC"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#F7FAFC" />
        <SolidColorBrush x:Key="PanelBrush" Color="#EEF4FA" />
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardSoftBrush" Color="#F8FBFF" />
        <SolidColorBrush x:Key="CardAltBrush" Color="#F7FAFD" />
        <SolidColorBrush x:Key="BorderBrushStrong" Color="#D4E0EC" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#E3EBF3" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5B6B7F" />
        <SolidColorBrush x:Key="InputTextBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="AccentBrush" Color="#4FD1C5" />
        <SolidColorBrush x:Key="AccentWarmBrush" Color="#F59E0B" />
        <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#F7FAFC" />
            <GradientStop Offset="0.45" Color="#F3F7FB" />
            <GradientStop Offset="1" Color="#EDF3F8" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HeaderPanelBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#FFFFFF" />
            <GradientStop Offset="0.55" Color="#F7FAFD" />
            <GradientStop Offset="1" Color="#F3F8FD" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#EAF5FF" />
            <GradientStop Offset="0.55" Color="#F0F8FF" />
            <GradientStop Offset="1" Color="#E8FFFB" />
        </LinearGradientBrush>
        <DropShadowEffect x:Key="ShellShadowEffect"
                          BlurRadius="36"
                          ShadowDepth="0"
                          Color="#7A8AA0"
                          Opacity="0.42" />
        <DropShadowEffect x:Key="CardShadowEffect"
                          BlurRadius="22"
                          ShadowDepth="0"
                          Color="#7A8AA0"
                          Opacity="0.28" />

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect" Value="{StaticResource CardShadowEffect}" />
        </Style>

        <Style x:Key="WorkspaceCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
            <Setter Property="Padding" Value="24" />
            <Setter Property="Background" Value="{StaticResource CardSoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="CornerRadius" Value="26" />
        </Style>

        <Style x:Key="MetricTileStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="CaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="#F7FAFD" />
            <Setter Property="BorderBrush" Value="#D0DDEA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EDF5FD" />
                    <Setter Property="BorderBrush" Value="#8CB6DA" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#E3EEF9" />
                    <Setter Property="BorderBrush" Value="#5E8FBE" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D0DDEA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D0DDEA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="38" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#EEF6FF" />
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E2F0FF" />
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="#FFFFFF"
                                BorderBrush="#D7E2EF"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#EAF4FF" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#8CB6DA" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#A8C4DD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource HeaderPanelBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="24"
                    Padding="22"
                    Effect="{StaticResource ShellShadowEffect}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>

                    <Border Width="54"
                            Height="54"
                            Background="#FAFCFF"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="10"
                            VerticalAlignment="Top">
                        <Image Source="Assets/yokonex-logo.png"
                               Stretch="Uniform" />
                    </Border>

                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center">
                        <TextBlock FontSize="12"
                                   Foreground="#4C84B3"
                                   Text="YOKONEX · BLE CONTROL STUDIO" />
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                    Text="键盘测速与波形联动工作台" />
                    </StackPanel>

                    <Grid Grid.Column="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Background="#FAFCFF"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="14">
                            <StackPanel>
                                <TextBlock FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="监听状态" />
                                <TextBlock x:Name="HeaderListeningBadge"
                                           Margin="0,8,0,0"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="#0F766E"
                                           Text="监听中" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Background="#FAFCFF"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="14">
                            <StackPanel>
                                <TextBlock FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="设备连接" />
                                <TextBlock x:Name="HeaderDeviceBadge"
                                           Margin="0,8,0,0"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#334155"
                                           TextWrapping="Wrap"
                                           Text="设备未连接" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <!-- 左侧把实时状态合并成单面板，减少来回切换时的视觉跳跃。 -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleStyle}"
                                           Text="实时概览" />
                                <TextBlock x:Name="CpmText"
                                           Margin="0,22,0,0"
                                           FontSize="52"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="0" />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource CaptionStyle}"
                                           Text="字符/分钟" />

                                <UniformGrid Margin="0,20,0,0"
                                             Columns="2">
                                    <Border Style="{StaticResource MetricTileStyle}"
                                            Margin="0,0,8,8">
                                        <StackPanel>
                                            <TextBlock Visibility="Collapsed"
                                                       Text="30 秒趋势" />
                                            <TextBlock Style="{StaticResource CaptionStyle}"
                                                       Text="30 秒趋势字符/分钟" />
                                            <TextBlock x:Name="TrendHeroText"
                                                       Margin="0,8,0,0"
                                                       FontSize="24"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       Text="0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource MetricTileStyle}"
                                            Margin="8,0,0,8">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CaptionStyle}"
                                                       Text="监听状态" />
                                            <TextBlock x:Name="StatusText"
                                                       Margin="0,8,0,0"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Foreground="#0F766E"
                                                       Text="监听中" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource MetricTileStyle}"
                                            Margin="0,8,8,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CaptionStyle}"
                                                       Text="样本数" />
                                            <TextBlock x:Name="SamplesText"
                                                       Margin="0,8,0,0"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       Text="0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource MetricTileStyle}"
                                            Margin="8,8,0,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CaptionStyle}"
                                                       Text="最近按键时间" />
                                            <TextBlock x:Name="LastKeyText"
                                                       Margin="0,8,0,0"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       Text="--:--:--" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <TextBlock x:Name="TrendText"
                                           Visibility="Collapsed"
                                           Text="0" />
                            </StackPanel>

                            <Border Grid.Row="1"
                                    Height="1"
                                    Background="#E5EDF5" />

                            <StackPanel Grid.Row="2">
                                <TextBlock Style="{StaticResource SectionTitleStyle}"
                                           Text="联动状态" />
                                <TextBlock x:Name="RuleText"
                                           Margin="0,16,0,0"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="命中规则: 未命中" />
                                <TextBlock x:Name="WaveformText"
                                           Margin="0,8,0,0"
                                           FontSize="14"
                                           Foreground="#4E78A0"
                                           Text="当前波形: 未触发" />

                                <Border Style="{StaticResource MetricTileStyle}"
                                        Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CaptionStyle}"
                                                   Text="设备摘要" />
                                        <TextBlock x:Name="DeviceStatusText"
                                                   Margin="0,10,0,0"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Text="未连接" />
                                        <TextBlock x:Name="BatteryText"
                                                   Margin="0,8,0,0"
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Text="电量: --" />
                                        <TextBlock x:Name="TelemetryText"
                                                   Margin="0,6,0,0"
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Text="遥测样本: 0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Border Grid.Row="3"
                                    Height="1"
                                    Background="#E5EDF5" />

                            <StackPanel Grid.Row="4">
                                <TextBlock Style="{StaticResource SectionTitleStyle}"
                                           Text="设备遥测" />

                                <Border Margin="0,16,0,0"
                                        Background="#FAFCFF"
                                        BorderBrush="{StaticResource BorderBrushSoft}"
                                        BorderThickness="1"
                                        CornerRadius="18"
                                        Padding="16">
                                    <StackPanel>
                                        <TextBlock x:Name="ChannelAStatusText"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Text="A 通道: --" />
                                        <TextBlock x:Name="ChannelBStatusText"
                                                   Margin="0,8,0,0"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Text="B 通道: --" />
                                        <TextBlock x:Name="MotorStatusText"
                                                   Margin="0,8,0,0"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Text="电机状态: --" />
                                        <TextBlock x:Name="StepCountStatusText"
                                                   Margin="0,8,0,0"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Text="设备步数: --" />
                                    </StackPanel>
                                </Border>

                                <UniformGrid Margin="0,16,0,0"
                                             Columns="2">
                                    <Border Style="{StaticResource MetricTileStyle}"
                                            Margin="0,0,8,8">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CaptionStyle}" Text="设备数" />
                                            <TextBlock x:Name="DevicesCountText"
                                                       Margin="0,8,0,0"
                                                       FontSize="24"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       Text="0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource MetricTileStyle}"
                                            Margin="8,0,0,8">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CaptionStyle}" Text="最近发包数" />
                                            <TextBlock x:Name="PacketCountText"
                                                       Margin="0,8,0,0"
                                                       FontSize="24"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       Text="0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource MetricTileStyle}"
                                            Margin="0,8,8,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CaptionStyle}" Text="波形数" />
                                            <TextBlock x:Name="WaveformsCountText"
                                                       Margin="0,8,0,0"
                                                       FontSize="24"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       Text="0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource MetricTileStyle}"
                                            Margin="8,8,0,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CaptionStyle}" Text="规则数" />
                                            <TextBlock x:Name="RulesCountText"
                                                       Margin="0,8,0,0"
                                                       FontSize="24"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       Text="0" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Border Margin="0,16,0,0"
                                        Background="{StaticResource CardAltBrush}"
                                        BorderBrush="{StaticResource BorderBrushSoft}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Padding="14">
                                    <TextBlock x:Name="ConfigPathText"
                                               FontSize="11"
                                               LineHeight="18"
                                               Foreground="#6B7C91"
                                               TextWrapping="Wrap"
                                               Text="配置文件: --" />
                                </Border>

                                <TextBlock x:Name="ErrorText"
                                           Margin="0,14,0,0"
                                           FontSize="12"
                                           LineHeight="20"
                                           TextWrapping="Wrap"
                                           Foreground="#C24141"
                                           Text="最近错误: 无" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </ScrollViewer>

                <Border Grid.Column="2"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="24"
                        Padding="24"
                        Effect="{StaticResource ShellShadowEffect}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="当前操作" />
                        </StackPanel>

                        <TabControl Grid.Row="2">
                        <TabItem Header="设备">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="340" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource WorkspaceCardStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitleStyle}"
                                                   Text="设备接入" />

                                        <TextBlock Margin="0,18,0,0"
                                                   Style="{StaticResource CaptionStyle}"
                                                   Text="可用设备" />
                                        <ComboBox x:Name="DevicesComboBox"
                                                  Margin="0,8,0,0"
                                                  DisplayMemberPath="Summary" />

                                        <UniformGrid Margin="0,20,0,0" Columns="2">
                                            <Button x:Name="ScanButton"
                                                    Margin="0,0,8,8"
                                                    Click="OnScanClicked"
                                                    Content="扫描设备" />
                                            <Button x:Name="RefreshButton"
                                                    Margin="8,0,0,8"
                                                    Click="OnRefreshClicked"
                                                    Content="刷新状态" />
                                            <Button x:Name="ConnectButton"
                                                    Margin="0,8,8,0"
                                                    Click="OnConnectClicked"
                                                    Content="连接设备" />
                                            <Button x:Name="DisconnectButton"
                                                    Margin="8,8,0,0"
                                                    Click="OnDisconnectClicked"
                                                    Content="断开设备" />
                                        </UniformGrid>

                                        <Button x:Name="StopButton"
                                                Margin="0,18,0,0"
                                                Click="OnStopClicked"
                                                Content="发送停止包" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource WorkspaceCardStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="18" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="18" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionTitleStyle}"
                                                       Text="设备反馈面板" />
                                        </StackPanel>

                                        <UniformGrid Grid.Row="2" Columns="2">
                                            <Border Background="#FFFFFF"
                                                    BorderBrush="#D7E2EF"
                                                    BorderThickness="1"
                                                    CornerRadius="18"
                                                    Padding="18"
                                                    Margin="0,0,10,0">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="连接摘要" />
                                                    <TextBlock Margin="0,10,0,0"
                                                               FontSize="16"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               Text="{Binding ElementName=DeviceStatusText, Path=Text}" />
                                                    <TextBlock Margin="0,8,0,0"
                                                               FontSize="13"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               Text="{Binding ElementName=BatteryText, Path=Text}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#FFFFFF"
                                                    BorderBrush="#D7E2EF"
                                                    BorderThickness="1"
                                                    CornerRadius="18"
                                                    Padding="18"
                                                    Margin="10,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="最近遥测" />
                                                    <TextBlock Margin="0,10,0,0"
                                                               FontSize="13"
                                                               LineHeight="22"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               Text="{Binding ElementName=TelemetryText, Path=Text}" />
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>

                                        <Border Grid.Row="4"
                                                Background="#FFFFFF"
                                                BorderBrush="#D7E2EF"
                                                BorderThickness="1"
                                                CornerRadius="18"
                                                Padding="18">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource CaptionStyle}" Text="详细遥测" />
                                                <TextBlock x:Name="DeviceTelemetryStatusText"
                                                           Margin="0,12,0,0"
                                                           FontSize="13"
                                                           LineHeight="24"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextWrapping="Wrap"
                                                           Text="--" />
                                             </StackPanel>
                                         </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="波形">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="292" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource WorkspaceCardStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitleStyle}"
                                                   Text="波形库" />

                                        <TextBlock Margin="0,18,0,0"
                                                   Style="{StaticResource CaptionStyle}"
                                                   Text="选择波形" />
                                        <ComboBox x:Name="WaveformsComboBox"
                                                  Margin="0,8,0,0"
                                                  SelectionChanged="OnWaveformSelectionChanged"
                                                  DisplayMemberPath="Name" />

                                        <Button x:Name="PlayWaveformButton"
                                                Margin="0,18,0,0"
                                                Click="OnPlayWaveformClicked"
                                                Content="试播选中波形" />

                                        <UniformGrid Margin="0,22,0,0" Columns="1">
                                            <Button Margin="0,0,0,10"
                                                    Click="OnNewWaveformClicked"
                                                    Content="新建波形" />
                                            <Button Margin="0,0,0,10"
                                                    Click="OnSaveWaveformClicked"
                                                    Content="保存波形" />
                                            <Button Click="OnDeleteWaveformClicked"
                                                    Content="删除波形" />
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="20" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Border Style="{StaticResource WorkspaceCardStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.1*" />
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="340" />
                                            </Grid.ColumnDefinitions>

                                            <Border Background="#FFFFFF"
                                                    BorderBrush="#D7E2EF"
                                                    BorderThickness="1"
                                                    CornerRadius="18"
                                                    Padding="16">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="波形预览" />
                                                    <Canvas x:Name="WaveformPreviewCanvas"
                                                            Margin="0,12,0,0"
                                                            Height="210"
                                                            Background="#F7FAFD" />
                                                </StackPanel>
                                            </Border>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource CaptionStyle}" Text="波形名称" />
                                                <TextBox x:Name="WaveformNameTextBox"
                                                         Margin="0,8,0,0"
                                                         Height="42" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="2">
                                        <Border Style="{StaticResource WorkspaceCardStyle}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="14" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="180" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource SectionTitleStyle}"
                                                                   Text="步骤可视化编辑器" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Click="OnAddWaveformStepClicked"
                                                            Content="添加步骤" />
                                                </Grid>

                                                <Border Grid.Row="2"
                                                        Background="#FFFFFF"
                                                        BorderBrush="#D7E2EF"
                                                        BorderThickness="1"
                                                        CornerRadius="18"
                                                        Padding="12">
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                                  PreviewMouseWheel="OnNestedScrollViewerPreviewMouseWheel">
                                                        <StackPanel x:Name="WaveformStepEditorPanel" />
                                                    </ScrollViewer>
                                                </Border>

                                                <!-- 这里保留隐藏脚本文本框，继续复用现有保存、预览和拖拽同步逻辑。 -->
                                                <TextBox x:Name="WaveformScriptTextBox"
                                                         Visibility="Collapsed"
                                                         AcceptsReturn="True"
                                                         TextChanged="OnWaveformScriptTextChanged"
                                                         TextWrapping="NoWrap"
                                                         VerticalScrollBarVisibility="Auto" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Grid>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="规则">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="320" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource WorkspaceCardStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitleStyle}"
                                                   Text="规则库" />

                                        <TextBlock Margin="0,18,0,0"
                                                   Style="{StaticResource CaptionStyle}"
                                                   Text="触发模式" />
                                        <ComboBox x:Name="TriggerModeComboBox"
                                                  Margin="0,8,0,0"
                                                  SelectionChanged="OnTriggerModeSelectionChanged"
                                                  DisplayMemberPath="Name" />

                                        <Border x:Name="KeypressModePanel"
                                                Margin="0,18,0,0"
                                                Background="#FFFFFF"
                                                BorderBrush="#D7E2EF"
                                                BorderThickness="1"
                                                CornerRadius="18"
                                                Padding="16">
                                            <StackPanel>
                                                <StackPanel x:Name="MouseClickPayloadPanel">
                                                    <TextBlock Style="{StaticResource CaptionStyle}"
                                                               Text="点击动作" />
                                                    <ComboBox x:Name="MouseClickPayloadComboBox"
                                                              Margin="0,8,0,0"
                                                              SelectionChanged="OnMouseClickPayloadSelectionChanged"
                                                              DisplayMemberPath="Name" />
                                                </StackPanel>

                                                <TextBlock x:Name="KeypressWaveformLabel"
                                                           Margin="0,16,0,0"
                                                           Style="{StaticResource CaptionStyle}"
                                                           Text="按键波形" />
                                                <ComboBox x:Name="KeypressWaveformComboBox"
                                                          Margin="0,8,0,0"
                                                          SelectionChanged="OnKeypressWaveformSelectionChanged"
                                                          DisplayMemberPath="Name" />

                                                <StackPanel x:Name="MouseClickFixedStrengthPanel"
                                                            Margin="0,16,0,0">
                                                    <TextBlock Style="{StaticResource CaptionStyle}"
                                                               Text="固定强度" />
                                                    <UniformGrid Margin="0,8,0,0"
                                                                 Columns="2">
                                                        <TextBox x:Name="MouseClickFixedAStrengthTextBox"
                                                                 Margin="0,0,8,0"
                                                                 Height="42"
                                                                 LostFocus="OnMouseClickFixedSettingLostFocus"
                                                                 KeyDown="OnMouseClickFixedSettingKeyDown" />
                                                        <TextBox x:Name="MouseClickFixedBStrengthTextBox"
                                                                 Margin="8,0,0,0"
                                                                 Height="42"
                                                                 LostFocus="OnMouseClickFixedSettingLostFocus"
                                                                 KeyDown="OnMouseClickFixedSettingKeyDown" />
                                                    </UniformGrid>

                                                    <TextBlock Margin="0,16,0,0"
                                                               Style="{StaticResource CaptionStyle}"
                                                               Text="持续时间（毫秒）" />
                                                    <TextBox x:Name="MouseClickFixedDurationTextBox"
                                                             Margin="0,8,0,0"
                                                             Height="42"
                                                             LostFocus="OnMouseClickFixedSettingLostFocus"
                                                             KeyDown="OnMouseClickFixedSettingKeyDown" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <Border x:Name="IdleTriggerPanel"
                                                Margin="0,18,0,0"
                                                Background="#FFFFFF"
                                                BorderBrush="#D7E2EF"
                                                BorderThickness="1"
                                                CornerRadius="18"
                                                Padding="16">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource CaptionStyle}"
                                                           Text="空闲触发" />
                                                <CheckBox x:Name="IdleTriggerEnabledCheckBox"
                                                          Margin="0,12,0,0"
                                                          Checked="OnIdleTriggerToggleChanged"
                                                          Unchecked="OnIdleTriggerToggleChanged"
                                                          Content="启用超时未输入自动触发" />

                                                <TextBlock Margin="0,16,0,0"
                                                           Style="{StaticResource CaptionStyle}"
                                                           Text="空闲阈值（毫秒）" />
                                                <TextBox x:Name="IdleTriggerTimeoutTextBox"
                                                         Margin="0,8,0,0"
                                                         Height="42"
                                                         LostFocus="OnIdleTriggerTimeoutLostFocus"
                                                         KeyDown="OnIdleTriggerTimeoutKeyDown" />

                                                <TextBlock Margin="0,16,0,0"
                                                           Style="{StaticResource CaptionStyle}"
                                                           Text="空闲波形" />
                                                <ComboBox x:Name="IdleWaveformComboBox"
                                                          Margin="0,8,0,0"
                                                          SelectionChanged="OnIdleWaveformSelectionChanged"
                                                          DisplayMemberPath="Name" />
                                            </StackPanel>
                                        </Border>

                                        <StackPanel x:Name="SpeedRuleListPanel">
                                            <TextBlock Margin="0,18,0,0"
                                                       Style="{StaticResource CaptionStyle}"
                                                       Text="选择规则" />
                                            <ComboBox x:Name="RulesComboBox"
                                                      Margin="0,8,0,0"
                                                      SelectionChanged="OnRuleSelectionChanged"
                                                      DisplayMemberPath="Name" />

                                            <UniformGrid Margin="0,22,0,0" Columns="1">
                                                <Button Margin="0,0,0,10"
                                                        Click="OnNewRuleClicked"
                                                        Content="新建规则" />
                                                <Button Margin="0,0,0,10"
                                                        Click="OnSaveRuleClicked"
                                                        Content="保存规则" />
                                                <Button Click="OnDeleteRuleClicked"
                                                        Content="删除规则" />
                                            </UniformGrid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource WorkspaceCardStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="20" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionTitleStyle}"
                                                       Text="规则编辑区" />
                                        </StackPanel>

                                        <Grid x:Name="SpecificKeyModePanel" Grid.Row="2">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="18" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="18" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SectionTitleStyle}"
                                                           Text="指定按键映射" />
                                            </StackPanel>

                                            <Border Grid.Row="2"
                                                    Background="#F7FAFD"
                                                    BorderBrush="#D7E2EF"
                                                    BorderThickness="1"
                                                    CornerRadius="22"
                                                    Padding="18">
                                                <Viewbox Stretch="Uniform"
                                                         StretchDirection="DownOnly"
                                                         HorizontalAlignment="Left">
                                                    <StackPanel x:Name="SpecificKeyKeyboardPanel" />
                                                </Viewbox>
                                            </Border>

                                            <Border Grid.Row="4"
                                                    Background="#FFFFFF"
                                                    BorderBrush="#D7E2EF"
                                                    BorderThickness="1"
                                                    CornerRadius="22"
                                                    Padding="18">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="200" />
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource CaptionStyle}"
                                                                   Text="当前选中按键" />
                                                        <TextBox x:Name="SpecificKeyTextBox"
                                                                 Margin="0,8,0,0"
                                                                 Height="42"
                                                                 IsReadOnly="True"
                                                                 Text="点击键帽选择按键" />

                                                        <TextBlock x:Name="SpecificKeyBindingStatusText"
                                                                   Margin="0,10,0,0"
                                                                   Foreground="#6B7C91"
                                                                   FontSize="12"
                                                                   Text="未选择按键" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Style="{StaticResource CaptionStyle}"
                                                                   Text="按下波形" />
                                                        <ComboBox x:Name="SpecificKeyWaveformComboBox"
                                                                  Margin="0,8,0,0"
                                                                  SelectionChanged="OnSpecificKeyWaveformSelectionChanged"
                                                                  DisplayMemberPath="Name" />

                                                        <UniformGrid Margin="0,16,0,0" Columns="2">
                                                            <Button Margin="0,0,8,0"
                                                                    Click="OnSaveSpecificKeyTriggerClicked"
                                                                    Content="保存映射" />
                                                            <Button Margin="8,0,0,0"
                                                                    Click="OnDeleteSpecificKeyTriggerClicked"
                                                                    Content="删除映射" />
                                                        </UniformGrid>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <Grid x:Name="SpeedRuleEditorPanel" Grid.Row="2">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="20" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.05*" />
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="0.95*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="规则名称" />
                                                    <TextBox x:Name="RuleNameTextBox"
                                                             Margin="0,8,0,0"
                                                             Height="42" />

                                                    <TextBlock Margin="0,20,0,0"
                                                               Style="{StaticResource CaptionStyle}"
                                                               Text="字符/分钟区间" />
                                                    <UniformGrid Margin="0,8,0,0" Columns="2">
                                                        <TextBox x:Name="RuleMinTextBox"
                                                                 Margin="0,0,8,0"
                                                                 Height="42" />
                                                        <TextBox x:Name="RuleMaxTextBox"
                                                                 Margin="8,0,0,0"
                                                                 Height="42" />
                                                    </UniformGrid>

                                                    <TextBlock Margin="0,20,0,0"
                                                               Style="{StaticResource CaptionStyle}"
                                                               Text="绑定波形" />
                                                    <ComboBox x:Name="RuleWaveformComboBox"
                                                              Margin="0,8,0,0"
                                                              SelectionChanged="OnRuleWaveformSelectionChanged"
                                                              DisplayMemberPath="Name" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="冷却时间（毫秒）" />
                                                    <TextBox x:Name="RuleCooldownTextBox"
                                                             Margin="0,8,0,0"
                                                             Height="42" />

                                                    <Border Margin="0,20,0,0"
                                                            Background="#FFFFFF"
                                                            BorderBrush="#D7E2EF"
                                                            BorderThickness="1"
                                                            CornerRadius="18"
                                                            Padding="16">
                                                        <StackPanel>
                                                            <TextBlock Style="{StaticResource CaptionStyle}" Text="规则行为" />
                                                            <CheckBox x:Name="RuleEnabledCheckBox"
                                                                      Margin="0,12,0,0"
                                                                      Content="启用规则" />
                                                            <CheckBox x:Name="RuleStopOnExitCheckBox"
                                                                      Content="离开区间时发送停止包" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                            <Border Grid.Row="2"
                                                    Background="#FFFFFF"
                                                    BorderBrush="#D7E2EF"
                                                    BorderThickness="1"
                                                    CornerRadius="18"
                                                    Padding="18">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.15*" />
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="0.85*" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource CaptionStyle}" Text="波形预览" />
                                                        <Canvas x:Name="RuleWaveformPreviewCanvas"
                                                                Margin="0,12,0,0"
                                                                Height="170"
                                                                Background="#F7FAFD" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Style="{StaticResource CaptionStyle}" Text="A 通道最大强度" />
                                                        <TextBlock x:Name="RuleWaveformPeakAText"
                                                                   Margin="0,8,0,0"
                                                                   FontSize="24"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   Text="0/180" />

                                                        <TextBlock Margin="0,20,0,0"
                                                                   Style="{StaticResource CaptionStyle}"
                                                                   Text="B 通道最大强度" />
                                                        <TextBlock x:Name="RuleWaveformPeakBText"
                                                                   Margin="0,8,0,0"
                                                                   FontSize="24"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   Text="0/180" />

                                                        <TextBlock Margin="0,20,0,0"
                                                                   Style="{StaticResource CaptionStyle}"
                                                                   Text="波形总时长" />
                                                        <TextBlock x:Name="RuleWaveformDurationText"
                                                                   Margin="0,8,0,0"
                                                                   FontSize="18"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#2D728F"
                                                                   Text="0 ms" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
    </Grid>
</Window>
