<Window x:Class="KeyboardSpeed.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Keyboard Speed YOKONEX"
        Height="640"
        Width="980"
        MinHeight="560"
        MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="#0B1020">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock
                FontSize="28"
                FontWeight="SemiBold"
                Foreground="#F8FAFC"
                Text="全局键盘测速监控" />
            <TextBlock
                Margin="0,8,0,0"
                FontSize="14"
                Foreground="#94A3B8"
                Text="当前版本已接入系统全局键盘监听，切到其他应用输入时也会持续统计打字速度。" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Padding="24"
                Background="#111827"
                BorderBrush="#1F2937"
                BorderThickness="1"
                CornerRadius="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="24" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="24" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#E2E8F0"
                        Text="实时速度" />

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Margin="0,0,12,0"
                            Padding="20"
                            Background="#0F172A"
                            BorderBrush="#1E293B"
                            BorderThickness="1"
                            CornerRadius="18">
                            <StackPanel>
                                <TextBlock
                                    FontSize="13"
                                    Foreground="#94A3B8"
                                    Text="KPM" />
                                <TextBlock
                                    x:Name="KpmText"
                                    Margin="0,8,0,0"
                                    FontSize="44"
                                    FontWeight="Bold"
                                    Foreground="#F8FAFC"
                                    Text="0" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            Padding="20"
                            Background="#0F172A"
                            BorderBrush="#1E293B"
                            BorderThickness="1"
                            CornerRadius="18">
                            <StackPanel>
                                <TextBlock
                                    FontSize="13"
                                    Foreground="#94A3B8"
                                    Text="WPM" />
                                <TextBlock
                                    x:Name="WpmText"
                                    Margin="0,8,0,0"
                                    FontSize="44"
                                    FontWeight="Bold"
                                    Foreground="#F8FAFC"
                                    Text="0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border
                        Grid.Row="4"
                        Padding="20"
                        Background="#0F172A"
                        BorderBrush="#1E293B"
                        BorderThickness="1"
                        CornerRadius="18">
                        <UniformGrid Columns="3">
                            <StackPanel>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="#94A3B8"
                                    Text="10 秒窗口样本" />
                                <TextBlock
                                    x:Name="SamplesText"
                                    Margin="0,8,0,0"
                                    FontSize="22"
                                    FontWeight="SemiBold"
                                    Foreground="#E2E8F0"
                                    Text="0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="#94A3B8"
                                    Text="30 秒趋势 KPM" />
                                <TextBlock
                                    x:Name="TrendText"
                                    Margin="0,8,0,0"
                                    FontSize="22"
                                    FontWeight="SemiBold"
                                    Foreground="#E2E8F0"
                                    Text="0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="#94A3B8"
                                    Text="最近按键时间" />
                                <TextBlock
                                    x:Name="LastKeyText"
                                    Margin="0,8,0,0"
                                    FontSize="22"
                                    FontWeight="SemiBold"
                                    Foreground="#E2E8F0"
                                    Text="--:--:--" />
                            </StackPanel>
                        </UniformGrid>
                    </Border>
                </Grid>
            </Border>

            <Border
                Grid.Column="2"
                Padding="24"
                Background="#111827"
                BorderBrush="#1F2937"
                BorderThickness="1"
                CornerRadius="20">
                <StackPanel>
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#E2E8F0"
                        Text="监听状态" />
                    <Border
                        Margin="0,20,0,0"
                        Padding="16"
                        Background="#0F172A"
                        BorderBrush="#1E293B"
                        BorderThickness="1"
                        CornerRadius="16">
                        <StackPanel>
                            <TextBlock
                                FontSize="12"
                                Foreground="#94A3B8"
                                Text="状态摘要" />
                            <TextBlock
                                x:Name="StatusText"
                                Margin="0,8,0,0"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="#22C55E"
                                Text="监听中" />
                        </StackPanel>
                    </Border>
                    <Border
                        Margin="0,16,0,0"
                        Padding="16"
                        Background="#0F172A"
                        BorderBrush="#1E293B"
                        BorderThickness="1"
                        CornerRadius="16">
                        <StackPanel>
                            <TextBlock
                                FontSize="12"
                                Foreground="#94A3B8"
                                Text="设备状态" />
                            <TextBlock
                                x:Name="DeviceStatusText"
                                Margin="0,8,0,0"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="#E2E8F0"
                                Text="未连接" />
                            <TextBlock
                                x:Name="BatteryText"
                                Margin="0,10,0,0"
                                FontSize="13"
                                Foreground="#CBD5E1"
                                Text="电量: --" />
                            <TextBlock
                                x:Name="ErrorText"
                                Margin="0,8,0,0"
                                FontSize="12"
                                TextWrapping="Wrap"
                                Foreground="#FCA5A5"
                                Text="最近错误: 无" />
                        </StackPanel>
                    </Border>

                    <Border
                        Margin="0,16,0,0"
                        Padding="16"
                        Background="#0F172A"
                        BorderBrush="#1E293B"
                        BorderThickness="1"
                        CornerRadius="16">
                        <StackPanel>
                            <TextBlock
                                FontSize="12"
                                Foreground="#94A3B8"
                                Text="蓝牙设备" />
                            <ComboBox
                                x:Name="DevicesComboBox"
                                Margin="0,12,0,0"
                                Height="36"
                                DisplayMemberPath="Summary"
                                Background="#111827"
                                Foreground="#F8FAFC"
                                BorderBrush="#334155" />
                            <UniformGrid Margin="0,12,0,0" Columns="2">
                                <Button
                                    x:Name="ScanButton"
                                    Margin="0,0,8,8"
                                    Padding="12,8"
                                    Click="OnScanClicked"
                                    Content="扫描设备" />
                                <Button
                                    x:Name="RefreshButton"
                                    Margin="8,0,0,8"
                                    Padding="12,8"
                                    Click="OnRefreshClicked"
                                    Content="刷新状态" />
                                <Button
                                    x:Name="ConnectButton"
                                    Margin="0,8,8,0"
                                    Padding="12,8"
                                    Click="OnConnectClicked"
                                    Content="连接设备" />
                                <Button
                                    x:Name="DisconnectButton"
                                    Margin="8,8,0,0"
                                    Padding="12,8"
                                    Click="OnDisconnectClicked"
                                    Content="断开设备" />
                            </UniformGrid>
                            <Button
                                x:Name="StopButton"
                                Margin="0,12,0,0"
                                Padding="12,8"
                                Click="OnStopClicked"
                                Content="发送停止包" />
                            <TextBlock
                                Margin="0,12,0,0"
                                TextWrapping="Wrap"
                                FontSize="12"
                                LineHeight="20"
                                Foreground="#CBD5E1"
                                Text="当前阶段已支持扫描、连接、断开和 EMS 停止包发送。后续会继续补设备遥测、波形试播和自动速度区间触发。" />
                        </StackPanel>
                    </Border>

                    <Border
                        Margin="0,16,0,0"
                        Padding="16"
                        Background="#0F172A"
                        BorderBrush="#1E293B"
                        BorderThickness="1"
                        CornerRadius="16">
                        <StackPanel>
                            <TextBlock
                                FontSize="12"
                                Foreground="#94A3B8"
                                Text="波形试播与当前规则" />
                            <TextBlock
                                x:Name="RuleText"
                                Margin="0,8,0,0"
                                FontSize="14"
                                Foreground="#E2E8F0"
                                Text="命中规则: 未命中" />
                            <TextBlock
                                x:Name="WaveformText"
                                Margin="0,6,0,0"
                                FontSize="14"
                                Foreground="#E2E8F0"
                                Text="当前波形: 未触发" />
                            <ComboBox
                                x:Name="WaveformsComboBox"
                                Margin="0,12,0,0"
                                Height="36"
                                SelectionChanged="OnWaveformSelectionChanged"
                                DisplayMemberPath="Name"
                                Background="#111827"
                                Foreground="#F8FAFC"
                                BorderBrush="#334155" />
                            <Button
                                x:Name="PlayWaveformButton"
                                Margin="0,12,0,0"
                                Padding="12,8"
                                Click="OnPlayWaveformClicked"
                                Content="试播选中波形" />
                            <Canvas
                                x:Name="WaveformPreviewCanvas"
                                Margin="0,16,0,0"
                                Height="120"
                                Background="#111827" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
